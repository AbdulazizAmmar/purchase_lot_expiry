<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Move Form View (Invoices & Vendor Bills) to display Lot Tags and Expiry Badges -->
    <record id="view_move_form_inherit_lot_expiry" model="ir.ui.view">
        <field name="name">account.move.form.inherit.lot.expiry</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']" position="after">
                <field name="product_tracking" column_invisible="True"/>
                <field name="lot_ids" widget="many2many_tags" optional="show" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}" options="{'no_quick_create': True}" invisible="not product_tracking or product_tracking == 'none'"/>
                <field name="lot_expiry_display" widget="badge" decoration-info="1" optional="show" invisible="not product_tracking or product_tracking == 'none'"/>
            </xpath>
        </field>
    </record>
</odoo>
