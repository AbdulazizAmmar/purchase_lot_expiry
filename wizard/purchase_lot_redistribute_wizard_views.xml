<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_lot_redistribute_wizard_form" model="ir.ui.view">
        <field name="name">purchase.lot.redistribute.wizard.form</field>
        <field name="model">purchase.lot.redistribute.wizard</field>
        <field name="arch" type="xml">
            <form string="Redistribute Lot Quantities">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not qty_mismatch">
                        <strong>Warning!</strong> The total allocated quantity does not match the purchase line quantity.
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_allocated_qty" readonly="1"/>
                            <field name="qty_mismatch" invisible="1"/>
                            <button name="action_distribute_evenly" type="object" string="Split Evenly" class="btn btn-secondary" icon="fa-balance-scale"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lot Allocation">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="lot_id" domain="[('product_id', '=', parent.product_id)]"/>
                                    <field name="expiration_date"/>
                                    <field name="quantity" sum="Total Allocated"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Confirm &amp; Apply to Picking" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
